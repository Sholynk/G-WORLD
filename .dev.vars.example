# ---------------------------------------------------------------------------
# G WORLD — local development secrets for apps/api (Cloudflare Workers).
# Copy to `apps/api/.dev.vars` (git-ignored) and adjust.
# These values are for LOCAL DEVELOPMENT ONLY and are never deployed.
# Production secrets are set with:
#   wrangler secret put SESSION_SECRET --config apps/api/wrangler.jsonc --env production
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# 32+ byte random string. Generate with: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef

# Comma-separated list of browser origins allowed to call the API with
# credentials. Keep empty when the frontend is served same-origin (default).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email delivery provider: "console" (writes to the email_messages outbox and
# logs to stdout — default in development) or "resend".
EMAIL_PROVIDER=console
EMAIL_FROM="G WORLD <no-reply@gworld.example>"
RESEND_API_KEY=
EMAIL_API_BASE_URL=https://api.resend.com

# Base URL used to build verification / reset links inside emails.
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8787

# Feature flags (see docs/07-development-workflow.md)
ENABLE_REGISTRATION=true
ENABLE_DEV_ROUTES=true

# Development only: multiplies the fixed-window rate limits (sign-in is 10 per
# 15 minutes per IP in production). Ignored when ENVIRONMENT=production.
RATE_LIMIT_MULTIPLIER=10
