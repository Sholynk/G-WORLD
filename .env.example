# ---------------------------------------------------------------------------
# G WORLD — optional root-level variables for tooling/scripts only.
# Application secrets live in `.dev.vars` (local) or Cloudflare secrets
# (`wrangler secret put`, production). Nothing here is bundled into the
# frontend. See apps/web/public/assets/js/core/config.js for public config.
# ---------------------------------------------------------------------------

# Cloudflare account that owns the D1 database, Workers and Pages projects.
CLOUDFLARE_ACCOUNT_ID=

# Names used by scripts/deploy helpers.
D1_DATABASE_NAME=g_world
WORKER_NAME=g-world-api
PAGES_PROJECT_NAME=g-world

# Public, non-secret values injected into the static frontend at deploy time.
PUBLIC_SITE_URL=https://gworld.pages.dev
PUBLIC_API_BASE_URL=/api/v1
