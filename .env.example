# ---------------------------------------------------------------------------
# Sholynk Tech — optional root-level variables for tooling/scripts only.
# Application secrets live in `apps/api/.dev.vars` (local) or Cloudflare
# secrets (`wrangler secret put`, production). Nothing here is bundled into
# the frontend. See apps/web/public/config.js for the public runtime config.
# ---------------------------------------------------------------------------

# Cloudflare account that owns the D1 database, Workers and Pages projects.
CLOUDFLARE_ACCOUNT_ID=

# Names used by scripts/deploy helpers.
D1_DATABASE_NAME=sholynk_tech
WORKER_NAME=sholynk-tech-api
PAGES_PROJECT_NAME=sholynk-tech
R2_BUCKET_NAME=sholynk-uploads

# Public, non-secret values injected into the static frontend at deploy time.
PUBLIC_SITE_URL=https://sholynk-tech.pages.dev
PUBLIC_API_BASE_URL=/api/v1
