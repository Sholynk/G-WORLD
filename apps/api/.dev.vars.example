# =============================================================================
# G WORLD — API worker, local development variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `apps/api/.dev.vars` and fill in real values:
#
#     cp apps/api/.dev.vars.example apps/api/.dev.vars
#
# `wrangler dev` reads it automatically and it is git-ignored, so this file is
# the documented shape and `.dev.vars` is the private copy. Nothing here is ever
# deployed — production values go in the wrangler `vars`/secrets (see
# apps/api/wrangler.jsonc and docs/06-deployment.md).
#
# The values below are development defaults: they are safe to copy verbatim
# because they only ever apply to a local SQLite database and a console email
# provider that prints messages to the terminal.
# =============================================================================

# development | production. Anything other than "production" relaxes a few
# guards (a default session secret is tolerated, verbose errors are returned).
ENVIRONMENT=development

# Signs session cookies and derives CSRF tokens. MUST be a long random string in
# production: generate one with `openssl rand -base64 48`, then store it as a
# secret with `wrangler secret put SESSION_SECRET --env production`.
SESSION_SECRET=dev-only-session-secret-do-not-use-in-production

# Origins allowed to call the API from a browser, comma separated. Leave empty
# when the Pages Function proxies /api/* (same-origin requests need no CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# console | resend. `console` logs each message to the wrangler output, which is
# how the local outbox works (GET /api/v1/auth/dev/outbox).
EMAIL_PROVIDER=console

# From: header on outgoing mail.
EMAIL_FROM=G WORLD <no-reply@gworld.example>

# Only needed when EMAIL_PROVIDER=resend. Get one at https://resend.com/api-keys
# (free tier: 3,000 emails/month, 100/day — see docs/06-deployment.md).
# Never commit a real key.
RESEND_API_KEY=

# Absolute URLs used in emails and links.
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8787/api/v1

# Allow public sign-up. Turn off for a closed pilot.
ENABLE_REGISTRATION=true

# Exposes /api/v1/auth/dev/* — reset rate limits, reset demo accounts, read the
# email outbox. Must be false in production.
ENABLE_DEV_ROUTES=true

# PBKDF2 iteration count. 10000 keeps the seeded demo accounts signable and the
# smoke suite fast; production uses 100000 (the wrangler.jsonc default).
PASSWORD_ITERATIONS=10000

# Multiplies every rate limit. 1 is the real production value; a higher number
# lets a full test run finish without tripping the sign-in limit.
RATE_LIMIT_MULTIPLIER=10
