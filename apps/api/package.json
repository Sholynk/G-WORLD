{
  "name": "@g-world/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "G WORLD API \u2014 Cloudflare Worker (Hono + D1)",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --port 8787 --ip 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:production": "wrangler deploy --env production --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply g_world --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply g_world --remote --env production --config wrangler.jsonc",
    "tail": "wrangler tail --config wrangler.jsonc"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "uqr": "^0.1.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.15",
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
