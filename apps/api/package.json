{
  "name": "@sholynk/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sholynk Tech API — Cloudflare Worker (Hono + D1 + R2)",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --port 8787 --ip 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:production": "wrangler deploy --env production --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply sholynk_tech --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply sholynk_tech --remote --env production --config wrangler.jsonc",
    "tail": "wrangler tail --config wrangler.jsonc"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "marked": "^16.4.2",
    "sanitize-html": "^2.17.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.15",
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/sanitize-html": "^2.13.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
