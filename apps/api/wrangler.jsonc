/**
 * Wrangler configuration — G WORLD API (Cloudflare Worker).
 *
 * Local development:  npm run dev:api         (wrangler dev, port 8787)
 * Migrations (local): npm run db:migrate:local
 * Deploy production:  npm run deploy:production -w @g-world/api
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * BEFORE THE FIRST DEPLOY
 *   1. wrangler login
 *   2. wrangler d1 create g_world
 *        → copy the returned `database_id` into `d1_databases[0].database_id`
 *          below (replace the all-zero sentinel)
 *   3. wrangler r2 bucket create g-world-uploads      (only if uploads are used)
 *   4. wrangler secret put SESSION_SECRET   --config apps/api/wrangler.jsonc --env production
 *   5. wrangler secret put RESEND_API_KEY   --config apps/api/wrangler.jsonc --env production  (if using Resend)
 *   6. npm run check:config     ← fails loudly while placeholders remain
 * ─────────────────────────────────────────────────────────────────────────────
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "g-world-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "g_world",
      "database_id": "e65dab59-c29a-4c35-9c91-f786fba614ab",
      "migrations_dir": "../../database/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "g-world-uploads",
      "preview_bucket_name": "g-world-uploads-preview"
    }
  ],

  // Cron: housekeeping every night at 03:17 UTC (expired sessions, tokens,
  // rate-limit windows, audit retention).
  "triggers": {
    "crons": ["17 3 * * *"]
  },

  // Non-secret configuration. Secrets never live in this file.
  "vars": {
    "ENVIRONMENT": "development",
    "APP_BASE_URL": "http://localhost:5173",
    "API_BASE_URL": "http://localhost:8787/api/v1",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "G WORLD <no-reply@gworld.example>",
    "ENABLE_REGISTRATION": "true",
    "ENABLE_DEV_ROUTES": "true",
    "SESSION_TTL_HOURS": "336"
  },

  "env": {
    // `wrangler dev` with no --env flag uses the top-level configuration above.
    "development": {
      "name": "g-world-api-dev",
      "vars": {
        "ENVIRONMENT": "development",
        "APP_BASE_URL": "http://localhost:5173",
        "API_BASE_URL": "http://localhost:8787/api/v1",
        "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
        "EMAIL_PROVIDER": "console",
        "EMAIL_FROM": "G WORLD <no-reply@gworld.example>",
        "ENABLE_REGISTRATION": "true",
        "ENABLE_DEV_ROUTES": "true",
        "PASSWORD_ITERATIONS": "10000",
        // Development-only relaxation so a full smoke-test run is not blocked
        // by the production sign-in limit. Ignored when ENVIRONMENT=production.
        "RATE_LIMIT_MULTIPLIER": "10"
      }
    },

    "production": {
      "name": "g-world-api",
      "workers_dev": true,
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "g_world",
          "database_id": "e65dab59-c29a-4c35-9c91-f786fba614ab",
          "migrations_dir": "../../database/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "g-world-uploads"
        }
      ],
      "triggers": {
        "crons": ["17 3 * * *"]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "APP_BASE_URL": "https://g-world.pages.dev",
        "API_BASE_URL": "/api/v1",
        // Empty: the Pages proxy makes the frontend same-origin, so no
        // cross-origin request is ever allowed. Add exact origins here only if
        // you deliberately host the frontend elsewhere.
        "ALLOWED_ORIGINS": "",
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM": "G WORLD <no-reply@your-domain.example>",
        "ENABLE_REGISTRATION": "true",
        "ENABLE_DEV_ROUTES": "false",
        "PASSWORD_ITERATIONS": "100000",
        "SESSION_TTL_HOURS": "336"
      }
    }
  }
}
